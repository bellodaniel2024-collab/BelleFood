# ============================================================
# BELLE FOOD — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to source control.
# ============================================================

# --- Database -----------------------------------------------------------
# SQLite (local dev):
DATABASE_URL="file:./dev.db"
# PostgreSQL (production):
# DATABASE_URL="postgresql://user:password@host:5432/belle_food?schema=public"

# --- NextAuth.js --------------------------------------------------------
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_RANDOM_SECRET_32_CHARS"
NEXTAUTH_URL="http://localhost:3000"

# --- Paystack -----------------------------------------------------------
# Obtain from: https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key"

# --- Email (Resend) -----------------------------------------------------
# Obtain from: https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key"
NOTIFICATION_EMAIL="orders@bellefood.ng"

# --- Restaurant Configuration -------------------------------------------
# These are overridden per-environment; keep defaults for dev
NEXT_PUBLIC_RESTAURANT_NAME="Belle Food"
NEXT_PUBLIC_RESTAURANT_PHONE="+234 XXX XXX XXXX"
NEXT_PUBLIC_RESTAURANT_WHATSAPP="+234XXXXXXXXXX"
NEXT_PUBLIC_RESTAURANT_EMAIL="hello@bellefood.ng"
NEXT_PUBLIC_RESTAURANT_ADDRESS="Lagos, Nigeria"
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=""
