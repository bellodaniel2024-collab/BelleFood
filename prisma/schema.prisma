// Belle Food — Prisma Schema
// To apply: npx prisma migrate dev --name init
// To seed:  npx prisma db seed

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Authentication ─────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  role          UserRole  @default(CUSTOMER)
  passwordHash  String?
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

// ─── Menu ────────────────────────────────────────────────────────────────────

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  imageUrl    String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  items       MenuItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model MenuItem {
  id           String          @id @default(cuid())
  name         String
  slug         String          @unique
  description  String?
  // Price stored in kobo (1 Naira = 100 kobo) to avoid floating-point issues
  priceKobo    Int
  imageUrl     String?
  isAvailable  Boolean         @default(true)
  isFeatured   Boolean         @default(false)
  sortOrder    Int             @default(0)
  categoryId   String
  category     Category        @relation(fields: [categoryId], references: [id])
  options      MenuItemOption[]
  orderItems   OrderItem[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model MenuItemOption {
  id         String       @id @default(cuid())
  name       String
  required   Boolean      @default(false)
  maxChoices Int          @default(1)
  choices    OptionChoice[]
  menuItemId String
  menuItem   MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
}

model OptionChoice {
  id           String         @id @default(cuid())
  name         String
  // Additional price in kobo (0 = no extra charge)
  extraKobo    Int            @default(0)
  isDefault    Boolean        @default(false)
  optionId     String
  option       MenuItemOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
}

// ─── Orders ──────────────────────────────────────────────────────────────────

model Order {
  id                String          @id @default(cuid())
  // Human-readable reference, e.g. BF-240001
  reference         String          @unique
  // Customer info (guest checkout supported)
  customerName      String
  customerEmail     String?
  customerPhone     String
  // Fulfillment
  fulfillmentType   FulfillmentType
  deliveryAddress   String?
  deliveryArea      String?
  deliveryNote      String?
  // Financials (all in kobo)
  subtotalKobo      Int
  deliveryFeeKobo   Int             @default(0)
  serviceFeeKobo    Int             @default(0)
  totalKobo         Int
  // Payment
  paymentMethod     PaymentMethod   @default(ONLINE)
  paymentStatus     PaymentStatus   @default(PENDING)
  paystackReference String?         @unique
  paystackData      String?         // JSON blob of Paystack verification response
  // Fulfillment lifecycle
  orderStatus       OrderStatus     @default(PENDING_CONFIRMATION)
  // Optional link to registered user
  userId            String?
  user              User?           @relation(fields: [userId], references: [id])
  // Line items
  items             OrderItem[]
  // Order notes
  customerNote      String?
  // Staff notes (not shown to customer)
  staffNote         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId   String
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id])
  quantity     Int
  // Snapshot prices at time of order (immutable — historical accuracy)
  unitPriceKobo Int
  totalKobo    Int
  // Snapshot of item name at time of order
  itemName     String
  // JSON of selected options, if any
  selectedOptions String?
  createdAt    DateTime @default(now())
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  ONLINE
  TRANSFER
  PAY_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

// ─── Restaurant Settings ─────────────────────────────────────────────────────

model RestaurantSettings {
  id                   String   @id @default(cuid())
  restaurantName       String   @default("Belle Food")
  phone                String?
  whatsapp             String?
  email                String?
  address              String?
  mapEmbedUrl          String?
  mapLat               Float?
  mapLng               Float?
  // Opening hours — JSON array of { day, openTime, closeTime, closed }
  openingHours         String?
  // Delivery settings
  deliveryEnabled      Boolean  @default(true)
  pickupEnabled        Boolean  @default(true)
  minimumOrderKobo     Int      @default(0)
  // Delivery areas — JSON array of { name, feeKobo }
  deliveryAreas        String?
  // Order acceptance
  acceptingOrders      Boolean  @default(true)
  orderClosedMessage   String?
  // Social
  instagramUrl         String?
  twitterUrl           String?
  facebookUrl          String?
  tiktokUrl            String?
  // Estimated times (minutes)
  estPrepMinutes       Int?
  estDeliveryMinutes   Int?
  // Service fee settings
  serviceFeeEnabled    Boolean  @default(false)
  serviceFeePercent    Float    @default(0)
  updatedAt            DateTime @updatedAt
}

// ─── Delivery Areas ──────────────────────────────────────────────────────────

model DeliveryArea {
  id        String  @id @default(cuid())
  name      String  @unique
  feeKobo   Int
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
}
